---
import type { GuideItem } from '../data/guides';

export interface Props {
  guide: GuideItem;
}

const { guide } = Astro.props;
const displayReadTime = guide.readTime || guide.readingTime;
const displayExcerpt = guide.excerpt || guide.description;
---

<article class="guide-card">
  <a href={`/guides/${guide.slug}`} class="guide-link">
    <div class="guide-meta">
      <span class="guide-category">{guide.category}</span>
      <span class="guide-read-time">{displayReadTime}</span>
    </div>
    <h3 class="guide-title">{guide.title}</h3>
    <p class="guide-excerpt">{displayExcerpt}</p>
    <div class="guide-footer">
      <span class="guide-cta">
        Read Practical Guide
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  .guide-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all var(--transition-fast);
  }

  .guide-card:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .guide-link {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
  }

  .guide-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--font-size-xs);
    margin-bottom: var(--space-3);
  }

  .guide-category {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }

  .guide-read-time {
    color: var(--color-text-muted);
  }

  .guide-title {
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-text);
    line-height: var(--line-height-tight);
    margin-bottom: var(--space-2);
  }

  .guide-excerpt {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    line-height: var(--line-height-normal);
    flex: 1;
    margin-bottom: var(--space-4);
  }

  .guide-footer {
    border-top: 1px solid var(--color-surface-subtle);
    padding-top: var(--space-3);
  }

  .guide-cta {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    transition: all var(--transition-fast);
  }

  .guide-card:hover .guide-cta {
    gap: var(--space-2);
    color: var(--color-accent);
  }
</style>
